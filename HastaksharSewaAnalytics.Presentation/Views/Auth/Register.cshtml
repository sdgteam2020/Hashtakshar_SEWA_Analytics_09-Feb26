@model HastaksharSewaAnalytics.Application.Dtos.User.RegisterVm
@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="register-container">

        <div class="card register-card panel-glow">
            <div class="text-center mb-3">
                <div class="register-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <h4 class="register-title mb-1">Create Account</h4>
                <div class="text-muted register-subtitle">
                    Hastakshar SEWA • Secure Analytics Access
                </div>
            </div>

            <hr class="border-secondary opacity-25" />

            <form id="registerForm" asp-controller="Auth" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2">
                        Please correct the errors and try again.
                        @Html.ValidationSummary(excludePropertyErrors: true, message: "")
                    </div>
                }

                <div class="mb-3">
                    <span id="spnhdns" class="d-none">@ViewBag.hdns</span>

                    <label class="form-label text-muted" for="regUsername">Username</label>
                    <input class="form-control register-pill"
                           id="regUsername"
                           name="Username"
                           value="@Model?.Username"
                           placeholder="Enter username"
                           autocomplete="off"
                           pattern="^(?=(?:.*_){0,2}$)(?=.*[A-Za-z])(?=.*\d)[A-Za-z0-9_]{4,15}$"
                           title="Username must be 4 to 15 characters, contain at least one letter, one number, and maximum 2 underscores (_)."
                           required />
                    <div class="text-danger small mt-1 d-none" id="usernameError">
                        @Html.ValidationMessage("Username")
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted" for="regPassword">Password</label>

                    <div class="input-group register-pill-group">
                        <input class="form-control"
                               type="password"
                               id="regPassword"
                               name="Password"
                               placeholder="Create password"
                               autocomplete="new-password"
                               required />

                        <button class="btn btn-olive-outline"
                                type="button"
                                id="toggleRegPwd"
                                aria-label="Show or hide password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <div class="text-danger small mt-1 d-none" id="passwordError">
                        @Html.ValidationMessage("Password")
                    </div>

                    <div class="text-muted small mt-2">
                        Use at least 8 characters with a number and an uppercase letter.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted" for="regConfirmPassword">Confirm Password</label>

                    <div class="input-group register-pill-group">
                        <input class="form-control"
                               type="password"
                               id="regConfirmPassword"
                               name="ConfirmPassword"
                               placeholder="Confirm password"
                               autocomplete="new-password"
                               required />

                        <button class="btn btn-olive-outline"
                                type="button"
                                id="toggleRegConfirmPwd"
                                aria-label="Show or hide confirm password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <div class="text-danger small mt-1 d-none" id="confirmPasswordError">
                        @Html.ValidationMessage("ConfirmPassword")
                    </div>
                </div>

                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-olive-outline py-2" aria-label="Create Account" >
                        <i class="bi bi-person-check me-1"></i>
                        Create Account
                    </button>
                </div>

                <div class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Login" class="small">
                        Already have an account? Sign in
                    </a>
                </div>

            </form>
        </div>

        <div class="text-center text-muted small mt-3">
            Authorized users only. All activities are logged.
        </div>

    </div>
</div>

@section Scripts {
    <script asp-src-include="~/lib/crypto-js/crypto-js.min.js"></script>
    <script src="~/js/register.js" asp-append-version="true"></script>
}