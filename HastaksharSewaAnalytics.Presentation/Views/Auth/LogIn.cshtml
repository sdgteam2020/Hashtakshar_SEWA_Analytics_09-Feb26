@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="login-container">

        <div class="card login-card panel-glow">
            <div class="text-center mb-3">
                <div class="login-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <h4 class="login-title mb-1">Hastakshar SEWA</h4>
                <div class="text-muted login-subtitle">
                    Secure Encryption &amp; Watermark Application
                </div>
            </div>

            <hr class="border-secondary opacity-25" />

            <form id="loginForm" asp-controller="Auth" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                 
                <div class="mb-3">
                    <span id="spnhdns" class="d-none">@ViewBag.hdns</span>
                    <label class="form-label text-muted">Username</label>
                    <input type="text"
                           id="loginUsername"
                           name="Username"
                           class="form-control"
                           placeholder="Enter username"
                           pattern="[a-zA-Z0-9_]+"
                           title="Only letters, numbers and underscore (_) are allowed"
                           autocomplete="off"
                           required />
                </div>
                 
                <div class="mb-3">
                    <label class="form-label text-muted">Password</label>
                    <div class="input-group">
                        <input type="password"
                               name="Password"
                               id="loginPassword"
                               class="form-control"
                               placeholder="Enter password"
                               autocomplete="off"
                               required />

                        <button class="btn btn-olive-outline"
                                type="button"
                                id="togglePasswordBtn">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
                 
                <div class="d-grid">
                    <button type="submit" class="btn btn-olive-outline py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Login
                    </button>
                </div>
                 
                <div class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Register" class="small">
                        Register a new user
                    </a>
                </div>

            </form>
        </div>

        <div class="text-center text-muted small mt-3">
            Authorized users only. All activities are logged.
        </div>

    </div>
</div>

@section Scripts {
    <script asp-src-include="~/lib/crypto-js/crypto-js.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <script>
        (function () {
          const reason = "@Context.Request.Query["reason"]";

          if (reason === "auth") {
            toastr.warning("Please login to continue.");
          }
          if (reason === "denied") {
            toastr.error("Access denied.");
          }
        })();
    </script>
}
