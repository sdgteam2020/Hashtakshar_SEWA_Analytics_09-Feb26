<div class="modal fade modal-olive" id="clientErrorLogDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Log Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2">
                    <div class="small text-muted">Error Message</div>
                    <div id="ced_errorMessage" class="fw-semibold"></div>
                </div>

                <hr />

                <div class="mb-2">
                    <div class="small text-muted">Stack Trace</div>
                    <pre id="ced_stackTrace" class="p-2 rounded bg-dark text-white border"></pre>
                </div>

                <div class="mt-3">
                    <div class="small text-muted">Extra</div>
                    <pre id="ced_extra" class="p-2 rounded bg-dark text-white border"></pre>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
