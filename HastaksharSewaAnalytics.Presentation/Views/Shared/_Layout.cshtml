<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HastaksharSewa Analytics</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
     
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
     
    <link rel="stylesheet" href="~/lib/toastr/build/toastr.min.css" />
     
    <link rel="stylesheet" href="~/datatables.net-dt/css/dataTables.dataTables.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
     
    @await RenderSectionAsync("Styles", required: false)
     
</head>

<body class="hs-theme"> 
    <nav class="navbar app-navbar sticky-top py-2">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <span class="emblem me-2"></span>
                <span class="fs-4 fw-bold">Hastakshar SEWA (Secure Encryption &amp; Watermark Application) Analytics</span>
            </div>
            <div class="text-end d-flex align-items-center gap-3">
                <small class="muted" id="today"></small>

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <span class="fw-semibold">
                        <i class="bi bi-person-circle me-1"></i>
                        @User.Identity!.Name
                    </span>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-olive-outline btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-olive-outline btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                }
            </div>

        </div>
    </nav>
     
    <main class="container-fluid px-3 px-md-4 my-3 my-md-4">
        @RenderBody()
    </main>
     
    <footer class="app-footer">
        <div class="container-fluid px-3 px-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
             
            <div>
                &copy; 2025 - HastaksharSEWA Analytics
            </div>
             
            <div class="d-none">
                <a asp-controller="Dashboard"  asp-action="Dashboard">Dashboard</a>
            </div>

        </div>
    </footer>

    <div class="modal fade modal-olive" id="sessionExpiredModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Session Expired</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Your session has expired. Please login again.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btnGoLogin">Login</button>
                </div>
            </div>
        </div>
    </div>
     
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> 
    <script src="~/datatables.net/dataTables.min.js"></script>
    <script src="~/datatables.net-dt/js/dataTables.dataTables.min.js"></script>
 
    <script src="~/lib/toastr/build/toastr.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
   
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(function () {          
                      @if (TempData["ToastSuccess"] != null)
                      {
                              <text>toastr.success("@TempData["ToastSuccess"]");</text>
                      }
                      @if (TempData["ToastError"] != null)
                      {
                              <text>toastr.error("@TempData["ToastError"]");</text>
                      }
                      @if (TempData["ToastWarning"] != null)
                      {
                              <text>toastr.warning("@TempData["ToastWarning"]");</text>
                      }
                      @if (TempData["ToastInfo"] != null)
                      {
                              <text>toastr.info("@TempData["ToastInfo"]");</text>
                      }
                    });
    </script>

</body>
</html>
