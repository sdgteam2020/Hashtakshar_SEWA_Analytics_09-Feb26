<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HastaksharSewaAnalytics.Presentation</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    @* add toastr *@
    <link rel="stylesheet" href="~/lib/toastr/build/toastr.min.css" />


    <!-- DataTables CSS (pick ONE, keep min) -->
    <link rel="stylesheet" href="~/datatables.net-dt/css/dataTables.dataTables.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Page-specific styles *@
    @await RenderSectionAsync("Styles", required: false)

    <link rel="stylesheet" href="~/HastaksharSewaAnalytics.Presentation.styles.css" asp-append-version="true" />
    
</head>

<body class="hs-theme">
    <!-- DASHBOARD HEADER (moved from Dashboard.cshtml) -->
    <nav class="navbar app-navbar sticky-top py-2">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <span class="emblem me-2"></span>
                <span class="fs-4 fw-bold">Hastakshar SEWA (Secure Encryption &amp; Watermark Application) Analytics</span>
            </div>
            <div class="text-end d-flex align-items-center gap-3">
                <small class="muted" id="today"></small>

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <span class="fw-semibold">
                        <i class="bi bi-person-circle me-1"></i>
                        @User.Identity!.Name
                    </span>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-olive-outline btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-olive-outline btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                }
            </div>

        </div>
    </nav>

    <!-- BODY -->
    <main class="container-fluid px-3 px-md-4 my-3 my-md-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="app-footer">
        <div class="container-fluid px-3 px-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">

            <!-- Left -->
            <div>
                &copy; 2025 - HastaksharSEWA Analytics
            </div>

            <!-- Center: Hit Counters -->
            <div class="d-flex align-items-center gap-3 small text-muted">

                <span class="d-flex align-items-center gap-2">
                    <span class="hit-badge" id="badgeDay">--</span>
                    Today: <strong id="hitToday">0</strong>
                </span>

                <span class="d-flex align-items-center gap-2">
                    <span class="hit-badge" id="badgeMonth">---</span>
                    Month: <strong id="hitMonth">0</strong>
                </span>

                <span>
                    <i class="bi bi-bar-chart-line me-1"></i>
                    Total: <strong id="hitTotal">0</strong>
                </span>

                <span>
                    <i class="bi bi-people-fill me-1"></i>
                    Online: <strong id="hitConcurrent">0</strong>
                </span>

            </div>

            <!-- Right -->
            <div>
                <a asp-controller="Dashboard" asp-action="Dashboard">Dashboard</a>
            </div>

        </div>
    </footer>


    <!-- SCRIPTS (load once only) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables JS (pick ONE set, keep consistent with your css) -->
    <script src="~/datatables.net/dataTables.js"></script>
    <script src="~/datatables.net-dt/js/dataTables.dataTables.js"></script>

    @* toastr *@
    <script src="~/lib/toastr/build/toastr.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
  

    @* Page-specific scripts *@
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(function () {
          toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: 3000
          };

          @if (TempData["ToastSuccess"] != null)
        {
                  <text>toastr.success("@TempData["ToastSuccess"]");</text>
          }
          @if (TempData["ToastError"] != null)
        {
                  <text>toastr.error("@TempData["ToastError"]");</text>
          }
          @if (TempData["ToastWarning"] != null)
        {
                  <text>toastr.warning("@TempData["ToastWarning"]");</text>
          }
          @if (TempData["ToastInfo"] != null)
        {
                  <text>toastr.info("@TempData["ToastInfo"]");</text>
          }
        });
    </script>

</body>
</html>
